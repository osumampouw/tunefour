# Copy to .env and adjust. Never commit real secrets.

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Database (matches docker-compose) ---
DATABASE_URL=postgresql://tunefour:tunefour@localhost:5432/tunefour

# --- Redis (WS pub/sub fan-out + cache) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO in dev; S3/GCS in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tunefour-media
S3_ACCESS_KEY=tunefour
S3_SECRET_KEY=tunefour-dev-secret

# --- Auth (Phase 1: local provider) ---
# AUTH_PROVIDER=local
JWT_ACCESS_SECRET=change-me-in-prod
JWT_REFRESH_SECRET=change-me-in-prod

# --- Admin portal ---
NEXT_PUBLIC_API_URL=http://localhost:3001
